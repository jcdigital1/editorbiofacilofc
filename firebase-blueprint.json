{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with authorization status and role",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "blocked"],
          "description": "Account authorization status"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "User authorization role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user registered"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user was approved by an admin"
        }
      },
      "required": ["uid", "email", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrative authority record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Administrator email address"
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when administrator was registered"
        }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User accounts with their approval status"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrator privileges mapping"
    }
  }
}
